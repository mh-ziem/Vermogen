{
  "name": "vermogen",
  "version": "0.1.0",
  "private": true,
  "description": "Vermögen — projetor de caixa pessoal",
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "build": "npm run build -w @vermogen/web && npm run build -w @vermogen/api",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "dev:db": "docker compose -f apps/api/dev/compose.yml up -d --wait",
    "dev:db:parar": "docker compose -f apps/api/dev/compose.yml down",
    "dev:api": "npm run dev -w @vermogen/api",
    "dev:web": "npm run dev -w @vermogen/web"
  }
}

# Variáveis do app (contrato: docs/SAD.md §6).
# Desenvolvimento local: copie para .env. Em produção, os valores vêm do compose do servidor.

PORT=3000
TZ=America/Sao_Paulo
LOG_LEVEL=info

# Endereço pelo qual o app é acessado. Com https, o cookie de sessão sai com "Secure".
PUBLIC_URL=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=54329
DB_NAME=vermogen
DB_USER=vermogen

# Produção: os segredos entram SEMPRE por arquivo.
# DB_PASSWORD_FILE=/run/secrets/db_password
# PGCRYPTO_KEY_FILE=/run/secrets/pgcrypto_key

# Só em desenvolvimento e teste (ignorados quando NODE_ENV=production).
# Valores do banco descartável de apps/api/dev/compose.yml; não são segredos reais.
DB_PASSWORD=vermogen_dev
PGCRYPTO_KEY=chave_de_desenvolvimento

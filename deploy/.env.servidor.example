# Modelo do arquivo /srv/vermogen/.env do servidor.
# Copie para o servidor como ".env" e preencha. Este arquivo NÃO guarda segredos:
# a senha do banco e a chave do pgcrypto ficam em /srv/vermogen/secrets/ (SAD DT-18).
# O roteiro completo está em docs/operacao/primeira-implantacao.md.

# Versão da imagem ghcr.io/mh-ziem/vermogen, sem o "v" da tag do git (ex.: tag v0.1.0 -> 0.1.0).
# Nunca use "latest".
VERMOGEN_VERSION=

# Porta do host onde o app fica, sempre em 127.0.0.1.
# Escolha uma porta livre depois de ler /srv/REGISTRY.md e registre-a lá.
VERMOGEN_PORT=

# Endereço pelo qual o app é acessado na tailnet, no formato https://<nome>.<tailnet>.ts.net
# (sem barra no final). Se o "tailscale serve" usar uma porta HTTPS diferente de 443,
# inclua a porta: https://<nome>.<tailnet>.ts.net:<porta-https>
VERMOGEN_PUBLIC_URL=

# Nível de log do app (padrão: info).
VERMOGEN_LOG_LEVEL=info
